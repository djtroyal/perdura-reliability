{
  "schema_version": 1,
  "default_confidence": 0.95,
  "validation_confidence_levels": [0.90, 0.95, 0.99],
  "bootstrap": {
    "default_refits": 499,
    "minimum_refits": 20,
    "maximum_refits": 2000,
    "minimum_success_fraction": 0.95,
    "seed_policy": "deterministic_from_analysis_data_model_estimator_confidence_and_grid"
  },
  "status_definitions": {
    "exact_primary": "Finite-sample pivotal inference is displayed by default.",
    "refit_primary": "On-demand estimator-matched refitting is the primary supported route.",
    "quick_opt_in": "Observed-information Wald/delta output is available only after explicit opt-in.",
    "withheld": "Numerical bounds are not reported because the implemented method is not justified for this regime.",
    "not_applicable": "The estimator or observation-model combination is not implemented; the UI must not describe an MLE fit as rank regression.",
    "credible": "Bayesian posterior probability, not frequentist confidence."
  },
  "required_validation_regimes": [
    "complete",
    "small_sample",
    "fixed_administrative_censoring",
    "type_ii_censoring",
    "planned_heterogeneous_censoring",
